<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.osman-butt</groupId>
    <artifactId>agent-inspector-parent</artifactId>
    <!-- Override with -Drevision=1.2.3: releases take it from the git tag. -->
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>agent-inspector</name>
    <description>See what your AI apps send to the model: requests, responses and tool calls</description>
    <url>https://github.com/osman-butt/agent-inspector</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>osman-butt</id>
            <name>osman-butt</name>
            <url>https://github.com/osman-butt</url>
        </developer>
    </developers>

    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/osman-butt/agent-inspector</url>
        <connection>scm:git:https://github.com/osman-butt/agent-inspector.git</connection>
        <developerConnection>scm:git:git@github.com:osman-butt/agent-inspector.git</developerConnection>
    </scm>

    <modules>
        <module>inspector-server</module>
        <module>inspector-spring-boot-starter</module>
        <module>inspector-sample</module>
    </modules>

    <properties>
        <revision>0.2.0-SNAPSHOT</revision>
        <java.version>25</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.osman-butt</groupId>
                <artifactId>agent-inspector-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.osman-butt</groupId>
                <artifactId>agent-inspector-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Publishes sources jars, so IDEs in projects using the starter can show its code. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The POMs that get installed and published are flattened: the actual version instead
                 of ${revision}, explicit dependency versions instead of a parent, and the license,
                 developers and scm that Maven Central requires spelled out in each. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Javadoc, signatures and the upload to Maven Central, for the GitHub workflows:
             ./mvnw deploy -Prelease. Signing reads the key from MAVEN_GPG_KEY and its passphrase
             from MAVEN_GPG_PASSPHRASE; the upload logs in as server "central-portal" in settings.xml.
             Not "central": Maven 3.10 ties that id's credentials to repo.maven.apache.org. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <!-- Signs in Java (BouncyCastle), so no gpg installation is needed. -->
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Snapshot versions go to Central's snapshot repository, releases are
                         validated and published without anything to click. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <!-- 0.12.0 or later: older versions bundle files that Maven 3.10 adds to the
                             staging repository, and Central rejects the deployment. -->
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central-portal</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <excludeArtifacts>
                                <excludeArtifact>agent-inspector-sample</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
