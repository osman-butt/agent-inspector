<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ek.osnb</groupId>
        <artifactId>agent-inspector-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>agent-inspector-spring-boot-starter</artifactId>
    <name>agent-inspector-spring-boot-starter</name>
    <description>Routes a Spring AI app's model traffic through an Agent Inspector, starting one in the app if none is running</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Started inside the app when no inspector is running. -->
        <dependency>
            <groupId>ek.osnb</groupId>
            <artifactId>agent-inspector-server</artifactId>
        </dependency>
        <!-- Provided by the Spring AI app this starter is added to. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
